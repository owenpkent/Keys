# Build output
build/
cmake-build-*/
release/
dist/

# IDE
.vs/
.idea/
*.user

# OS
.DS_Store
Thumbs.db

# Python bytecode. run.py is a module as well as a script (tooling imports it to reuse
# close_running and find_cmake), so importing it leaves a cache directory behind.
__pycache__/
*.pyc

# Reference manuals for the hardware and plugins the design borrows from, in manuals/.
# They are third-party PDFs and they are large, so they are research material sitting next
# to the code rather than part of it. manuals/README.md is tracked and carries a download
# URL for every one of them. Anything worth keeping out of a manual belongs in docs/ as our
# own prose.
*.pdf

# Corpora and MIDI packs used for analysis. Large, third-party, and licensed per-source
# (datasets/README.md is the manifest). Never redistributed with Keys.
datasets/*.csv
datasets/*.parquet
datasets/*.pkl
datasets/*.zip
datasets/*.jsonl
